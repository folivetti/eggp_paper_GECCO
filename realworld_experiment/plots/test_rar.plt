set terminal pdf noenhanced

set datafile separator comma

f2_nll(X1)=((X1 - (-0.1365166 - sqrt(abs((((3.4237995 * X1) - (abs(X1) ** 0.59143263)) + 0.03041258))))) - (abs(X1) ** 0.73515725)) # nll=-1288, dl=-1224.40
f3_nll(X1)=((2.703821 + (abs((abs(X1) ** 0.18491772)) ** 3.180001)) / (abs((((abs(X1) ** 2.1215827) + -0.00030065756) / (abs(3.669845) ** 2.3977969))) ** -0.2505678)) # nll=-1294, dl -1243.5597
f4_nll(X1)=sqrt(abs((-0.3850382 * ((abs((X1 + -0.01628182)) ** 0.49394095) + ((-0.73192716 * X1) + ((1.2387838 + X1) - 1.3252368)))))) + X1 # nll: -1314.4 dl: -1259
f5_nll(X1)=(((abs(X1) ** 1.8236951) / (-0.21841796 * X1)) / (1/((abs(X1) ** 0.31053516)) - ((abs((58.721386 * X1)) ** -0.76524365) + 3.6037335))) # nll: -1560 dl: -1500

f1_dl(X1)=(sqrt(abs((-0.022228241 + X1))) + (((X1 ** log(abs(2.826951))) + (0.72457486 * 0.12600218)) * (-1.4072703 + 2.05157))) # dl: -1231 nll: -1280
f2_dl(X1)=abs(((((X1 + (1/((abs(X1) ** 0.72668695)) / 0.360207)) + 30.172329) / sqrt(abs((abs(X1) ** -1.3019626)))) + -3.191896) / -18.014408) # dl: -1529 nll: -1572
f2_dla(X1)=0.0555111 * ((2.77618/abs(X1)**0.726687 + X1 + 30.1723) * abs(X1)**0.650981 - 3.1919)

set output 'rar.pdf'
set logscale y
set logscale x

set xlabel "gbar"
set ylabel "gobs"
set sample 10000
set key right bottom
set xrange [0.0001:1000]
plot '../datasets/RAR.csv' using 'gbar':'gobs' with dots notitle,\
    f2_nll(x) with line title 'opt nll dl=-1224',\
    f3_nll(x) with line title 'opt nll dl=-1244',\
    f4_nll(x) with line title 'opt nll dl=-1259',\
    f5_nll(x) with line title 'opt nll dl=-1500',\
    f1_dl(x) with line title 'opt dl dl=-1231',\
    f2_dla(x) with line title 'opt dl dl=-1520 !'
    
    
f1_best_nll(X1)=abs(((abs(1/(sqrt(abs(X1)))) ** 0.16467132) + (((abs(X1) ** 0.16172025) / 0.48964465) + -2.3322625)) + X1)
f2_best_nll(X1)=(X1 - (log(abs(((X1 * (-22.77422 - (((log(abs(((-4.4421706 * X1) + 20.54515))) / -1.3911123) / sqrt(abs((1/(X1) * X1)))) / X1))) + -3.5503447))) / -4.5545964))
f1_best_dl(X1)=abs((abs((1/(((X1 * 0.16053139) + (1.6278552 * (abs(X1) ** -1.1875677)))) + (X1 * -0.21517406))) ** 0.3079555) + X1)
f2_best_dl(X1)=((abs(((1/(X1) + 0.44475305) * sqrt(abs(X1)))) ** -1.0183301) + X1)
fk_best_dl(X1)=(sqrt(abs((abs(X1) ** 0.9925136))) + (X1 / 1.4147066))
fk_best_dl_simpl(X1)=(sqrt(X1) + (X1 / sqrt(2))) # 1.4147066
plot '../datasets/RAR.csv' using 'gbar':'gobs' with dots notitle,\
    f1_best_nll(x) with line sharpen title 'GP_nll 1st nll:-1030 dl:-977',\
    f2_best_nll(x) with line sharpen title 'GP_nll 2st nll:-1058 dl:-975',\
    f1_best_dl(x) with line sharpen title 'GP_dl 1st nll:-1050 dl:-990',\
    f2_best_dl(x) with line sharpen title 'GP_dl 2nd nll:-1024 dl:-987',\
    fk_best_dl(x) with line sharpen title 'GP_dl kth nll:-1012 dl:-977',\
    fk_best_dl_simpl(x) with line sharpen title 'GP_dl kth (simpl)'
    
unset yrange
plot abs(fk_best_dl(x) - fk_best_dl_simpl(x))/fk_best_dl_simpl(x) with line title 'rel. diff'
    
    
    

